# Copy to terraform.tfvars (that file is git-ignored) and fill in.
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Key of the Litestream IAM application (object read/write only).
litestream_access_key_id = "SCW..."
litestream_secret_key    = "..."

# Google sign-in (OAuth client).
google_client_id     = "....apps.googleusercontent.com"
google_client_secret = "..."

# The domain defaults to xuexi.nl (DNS records are created automatically). Set "" for IP-only.
# domain = "xuexi.nl"

# zone   = "nl-ams-1"
# region = "nl-ams"
