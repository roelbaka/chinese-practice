      "topic": "会话1 · Dialogue 1 (Buying Apples)",
      "items": [
        {
          "zh": "售货员：您要什么？",
          "py": "Shòuhuòyuán: Nín yào shénme?",
          "en": "Shop assistant: What would you like?"
        },
        {
          "zh": "大卫：我要苹果。多少钱一斤？",
          "py": "Dàwèi: Wǒ yào píngguǒ. Duōshao qián yī jīn?",
          "en": "David: I want apples. How much per jin?"
        },
        {
          "zh": "售货员：七块五（毛）。",
          "py": "Shòuhuòyuán: Qī kuài wǔ (máo).",
          "en": "Shop assistant: Seven fifty."
        },
        {
          "zh": "大卫：那种呢？",
          "py": "Dàwèi: Nà zhǒng ne?",
          "en": "David: How about that kind?"
        },
        {
          "zh": "售货员：九块三。",
          "py": "Shòuhuòyuán: Jiǔ kuài sān.",
          "en": "Shop assistant: Nine thirty."
        },
        {
          "zh": "大卫：要这种吧。",
          "py": "Dàwèi: Yào zhè zhǒng ba.",
          "en": "David: I'll take this kind."
        },
        {
          "zh": "售货员：要多少？",
          "py": "Shòuhuòyuán: Yào duōshao?",
          "en": "Shop assistant: How much do you want?"
        },
        {
          "zh": "大卫：两斤。",
          "py": "Dàwèi: Liǎng jīn.",
          "en": "David: Two jin."
        },
        {
          "zh": "售货员：还要别的吗？",
          "py": "Shòuhuòyuán: Hái yào bié de ma?",
          "en": "Shop assistant: Anything else?"
        },
        {
          "zh": "大卫：不要了。",
          "py": "Dàwèi: Bú yào le.",
          "en": "David: No, that's all."
        }
      ]
    },
