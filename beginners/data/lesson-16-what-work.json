        },
        {
          "zh": "大卫：她穿一件红毛衣。",
          "py": "Dàwèi: Tā chuān yī jiàn hóng máoyī.",
          "en": "David: She's wearing a red sweater."
        },
        {
          "zh": "职员：哦，是不是那个日本留学生？",
          "py": "Zhíyuán: Ó, shì bu shì nàge Rìběn liúxuéshēng?",
          "en": "Staff: Oh, is it that Japanese exchange student?"
        },
        {
          "zh": "大卫：对，就是她。",
          "py": "Dàwèi: Duì, jiù shì tā.",
          "en": "David: Yes, that's her."
        },
        {
          "zh": "职员：她刚出去了。",
          "py": "Zhíyuán: Tā gāng chūqù le.",
          "en": "Staff: She just went out."
        }
      ]
