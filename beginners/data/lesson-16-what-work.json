      "items": [
        {
          "zh": "他做什么工作？",
          "py": "Tā zuò shénme gōngzuò?",
          "en": "What work does he do?"
        },
        {
          "zh": "他是大夫。",
          "py": "Tā shì dàifu.",
          "en": "He is a doctor."
        },
        {
          "zh": "她长得怎么样？",
          "py": "Tā zhǎng de zěnmeyàng?",
          "en": "What does she look like?"
        },
        {
          "zh": "她个子不高也不矮。",
          "py": "Tā gèzi bù gāo yě bù ǎi.",
          "en": "She is neither tall nor short."
        },
        {
          "zh": "她穿什么衣服？",
          "py": "Tā chuān shénme yīfu?",
          "en": "What is she wearing?"
        },
        {
          "zh": "他看起来很年轻。",
          "py": "Tā kàn qǐlái hěn niánqīng.",
          "en": "He looks very young."
        },
        {
          "zh": "他今年三十五岁。",
          "py": "Tā jīnnián sānshíwǔ suì.",
          "en": "He is thirty-five this year."
        }
      ]
