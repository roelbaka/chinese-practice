      "items": [
        {
          "zh": "玛丽：你认识那个人吗？",
          "py": "Mǎlì: Nǐ rènshi nàge rén ma?",
          "en": "Mary: Do you know that person?"
        },
        {
          "zh": "大卫：哪个人？",
          "py": "Dàwèi: Nǎge rén?",
          "en": "David: Which person?"
        },
        {
          "zh": "玛丽：穿白衬衫的那个人。",
          "py": "Mǎlì: Chuān bái chènshān de nàge rén.",
          "en": "Mary: The one wearing a white shirt."
        },
        {
          "zh": "大卫：认识，他是我的朋友。",
          "py": "Dàwèi: Rènshi, tā shì wǒ de péngyou.",
          "en": "David: Yes, he's my friend."
        },
        {
          "zh": "玛丽：他做什么工作？",
          "py": "Mǎlì: Tā zuò shénme gōngzuò?",
          "en": "Mary: What does he do?"
        },
        {
          "zh": "大卫：他是大夫，在医院工作。",
          "py": "Dàwèi: Tā shì dàifu, zài yīyuàn gōngzuò.",
          "en": "David: He's a doctor; he works at a hospital."
        },
        {
          "zh": "玛丽：他看起来很年轻。今年多大了？",
          "py": "Mǎlì: Tā kàn qǐlái hěn niánqīng. Jīnnián duō dà le?",
          "en": "Mary: He looks very young. How old is he?"
        },
        {
          "zh": "大卫：他今年三十五岁。",
          "py": "Dàwèi: Tā jīnnián sānshíwǔ suì.",
          "en": "David: He's thirty-five this year."
        }
      ]
    },
    {
      "topic": "会话2 · Dialogue 2 (What does she look like?)",
      "items": [
        {
          "zh": "大卫：请问，和子在吗？",
          "py": "Dàwèi: Qǐngwèn, Hézǐ zài ma?",
          "en": "David: Excuse me, is Hezi here?"
        },
        {
          "zh": "职员：和子？她长得怎么样？",
