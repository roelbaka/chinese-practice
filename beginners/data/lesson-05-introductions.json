{
  "title": "第五课 · 我介绍一下儿",
  "subtitle": "Lesson 5 — 我介绍一下儿 · Let Me Introduce — Introductions, 的, locations & visiting",
  "data": [
    {
      "topic": "句子 · Key Sentences",
      "items": [
        {
          "zh": "他是谁？",
          "py": "Tā shì shuí?",
          "en": "Who is he?"
        },
        {
          "zh": "我介绍一下儿。",
          "py": "Wǒ jièshào yíxiàr.",
          "en": "Let me introduce..."
        },
        {
          "zh": "你去哪儿？",
          "py": "Nǐ qù nǎr?",
          "en": "Where are you going?"
        },
        {
          "zh": "张老师在家吗？",
          "py": "Zhāng lǎoshī zài jiā ma?",
          "en": "Is Teacher Zhang home?"
        },
        {
          "zh": "我是张老师的学生。",
          "py": "Wǒ shì Zhāng lǎoshī de xuéshēng.",
          "en": "I am Teacher Zhang's student."
        },
        {
          "zh": "请进！",
          "py": "Qǐng jìn!",
          "en": "Please come in!"
        }
      ]
    },
    {
      "topic": "会话1 · Dialogue 1 (Introduction)",
      "items": [
        {
          "zh": "玛丽：王兰，他是谁？",
          "py": "Mǎlì: Wáng Lán, tā shì shuí?",
          "en": "Mary: Wang Lan, who is he?"
        },
        {
          "zh": "王兰：玛丽，我介绍一下儿，这是我哥哥。",
          "py": "Wáng Lán: Mǎlì, wǒ jièshào yíxiàr, zhè shì wǒ gēge.",
          "en": "Wang Lan: Mary, let me introduce — this is my older brother."
        },
        {
          "zh": "王林：我叫王林。认识你，很高兴。",
          "py": "Wáng Lín: Wǒ jiào Wáng Lín. Rènshi nǐ, hěn gāoxìng.",
          "en": "Wang Lin: My name is Wang Lin. Nice to meet you."
        },
        {
          "zh": "玛丽：认识你，我也很高兴。",
          "py": "Mǎlì: Rènshi nǐ, wǒ yě hěn gāoxìng.",
          "en": "Mary: Nice to meet you too."
        },
        {
          "zh": "王兰：你去哪儿？",
          "py": "Wáng Lán: Nǐ qù nǎr?",
          "en": "Wang Lan: Where are you going?"
        },
        {
          "zh": "玛丽：我去北京大学。你们去哪儿？",
          "py": "Mǎlì: Wǒ qù Běijīng Dàxué. Nǐmen qù nǎr?",
          "en": "Mary: I'm going to Peking University. Where are you going?"
        },
        {
          "zh": "王林：我们去商店。",
          "py": "Wáng Lín: Wǒmen qù shāngdiàn.",
          "en": "Wang Lin: We're going to the shop."
        },
        {
          "zh": "玛丽：再见！",
          "py": "Mǎlì: Zàijiàn!",
          "en": "Mary: Goodbye!"
        },
        {
          "zh": "王兰、王林：再见！",
          "py": "Wáng Lán, Wáng Lín: Zàijiàn!",
          "en": "Wang Lan & Wang Lin: Goodbye!"
        }
      ]
    },
    {
      "topic": "会话2 · Dialogue 2 (Visiting)",
      "items": [
        {
          "zh": "和子：张老师在家吗？",
          "py": "Hézǐ: Zhāng lǎoshī zài jiā ma?",
          "en": "Kazuko: Is Teacher Zhang home?"
        },
        {
          "zh": "小英：在。您是……",
          "py": "Xiǎo Yīng: Zài. Nín shì...",
          "en": "Xiao Ying: Yes. You are...?"
        },
        {
          "zh": "和子：我是张老师的学生，我姓山下。我叫和子。你是……",
          "py": "Hézǐ: Wǒ shì Zhāng lǎoshī de xuéshēng, wǒ xìng Shānxià. Wǒ jiào Hézǐ. Nǐ shì...",
          "en": "Kazuko: I'm Teacher Zhang's student, my surname is Yamashita. My name is Kazuko. You are...?"
        },
        {
          "zh": "小英：我叫小英。张老师是我爸爸。请进！",
          "py": "Xiǎo Yīng: Wǒ jiào Xiǎo Yīng. Zhāng lǎoshī shì wǒ bàba. Qǐng jìn!",
          "en": "Xiao Ying: I'm Xiao Ying. Teacher Zhang is my dad. Please come in!"
        },
        {
          "zh": "和子：谢谢！",
          "py": "Hézǐ: Xièxie!",
          "en": "Kazuko: Thank you!"
        }
      ]
    },
