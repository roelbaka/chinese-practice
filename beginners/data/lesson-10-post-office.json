    {
      "topic": "语法 · Grammar",
      "items": [
        {
          "zh": "邮局在银行旁边。",
          "py": "Yóujú zài yínháng pángbiān.",
          "en": "在 indicates location: something is at / in / on a place (place + 在 + reference + 方位词)."
        },
        {
          "zh": "超市在邮局对面。",
          "py": "Chāoshì zài yóujú duìmiàn.",
          "en": "方位词 (position words) like 旁边、对面、前边 attach to a reference noun to show where something is."
        },
        {
          "zh": "离这儿远不远？",
          "py": "Lí zhèr yuǎn bu yuǎn?",
          "en": "离 … 远 / 近 expresses distance from a point: 离 + place + 远/近."
        },
        {
          "zh": "离学校很近。",
          "py": "Lí xuéxiào hěn jìn.",
          "en": "It's very close to the school."
        },
        {
          "zh": "往左拐 / 往前走",
          "py": "wǎng zuǒ guǎi / wǎng qián zǒu",
          "en": "往 + direction + verb gives directions: toward + left/right/front + turn / walk."
        },
        {
          "zh": "去邮局怎么走？",
          "py": "Qù yóujú zěnme zǒu?",
          "en": "怎么走 asks how to get somewhere (literally \"how to walk\")."
        }
      ]
    },
