    {
      "topic": "语法 · Grammar",
      "items": [
        {
          "zh": "邮局在银行旁边。",
          "py": "Yóujú zài yínháng pángbiān.",
          "en": "在 indicates location: something is at / in / on a place (place + 在 + reference + 方位词)."
        },
        {
          "zh": "超市在邮局对面。",
          "py": "Chāoshì zài yóujú duìmiàn.",
          "en": "方位词 (position words) like 旁边、对面、前边 attach to a reference noun to show where something is."
        },
        {
          "zh": "离这儿远不远？",
          "py": "Lí zhèr yuǎn bu yuǎn?",
          "en": "离 … 远 / 近 expresses distance from a point: 离 + place + 远/近."
        },
        {
          "zh": "离学校很近。",
          "py": "Lí xuéxiào hěn jìn.",
          "en": "It's very close to the school."
        },
        {
          "zh": "往左拐 / 往前走",
          "py": "wǎng zuǒ guǎi / wǎng qián zǒu",
          "en": "往 + direction + verb gives directions: toward + left/right/front + turn / walk."
        },
        {
          "zh": "去邮局怎么走？",
          "py": "Qù yóujú zěnme zǒu?",
          "en": "怎么走 asks how to get somewhere (literally \"how to walk\")."
        },
        {
          "zh": "那个楼就是八号楼。",
          "py": "Nà ge lóu jiù shì bā hào lóu.",
          "en": "就 heightens the positive tone — \"that building is right there\" / \"exactly that one\"."
        },
        {
          "zh": "就在银行前边。",
          "py": "Jiù zài yínháng qiánbian.",
          "en": "就 emphasizes certainty: \"right in front of the bank\"."
        },
        {
          "zh": "就在那儿。",
          "py": "Jiù zài nàr.",
          "en": "Right over there. (就 reinforces \"right there\")"
        },
        {
          "zh": "请问，邮局在哪儿？",
          "py": "Qǐngwèn, yóujú zài nǎr?",
          "en": "请问 is a polite formula placed before a question when asking strangers."
        },
        {
          "zh": "邮局离这儿远不远？",
          "py": "Yóujú lí zhèr yuǎn bu yuǎn?",
          "en": "Affirmative-negative question: 远不远 (far or not far) — no 吗 needed."
