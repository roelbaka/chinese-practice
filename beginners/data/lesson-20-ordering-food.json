{
  "title": "第二十课 · 你要什么",
  "subtitle": "Lesson 20 — 你要什么 · What would you like to order",
  "data": [
    {
      "topic": "句子 · Key Sentences",
      "items": [
        {
          "zh": "你要什么？",
          "py": "Nǐ yào shénme?",
          "en": "What would you like (to order)?"
        },
        {
          "zh": "来一个鱼香肉丝。",
          "py": "Lái yī gè yúxiāng ròusī.",
          "en": "I'll have a fish-flavored shredded pork."
        },
        {
          "zh": "你们想喝点儿什么？",
          "py": "Nǐmen xiǎng hē diǎnr shénme?",
          "en": "What would you like to drink?"
        },
        {
          "zh": "来两瓶啤酒。",
          "py": "Lái liǎng píng píjiǔ.",
          "en": "Two bottles of beer, please."
        },
        {
          "zh": "菜够了吗？",
          "py": "Cài gòu le ma?",
          "en": "Is that enough dishes?"
        },
        {
          "zh": "买单！",
          "py": "Mǎi dān!",
          "en": "Check, please!"
        },
        {
          "zh": "味道怎么样？",
          "py": "Wèidao zěnmeyàng?",
          "en": "How does it taste?"
        },
        {
          "zh": "好吃极了！",
          "py": "Hǎo chī jí le!",
          "en": "Extremely delicious!"
        }
      ]
    },
    {
      "topic": "会话1 · Dialogue 1 (At the Restaurant)",
      "items": [
        {
          "zh": "服务员：几位？",
          "py": "Fúwùyuán: Jǐ wèi?",
          "en": "Waiter: How many?"
        },
        {
          "zh": "刘京：三位。",
          "py": "Liú Jīng: Sān wèi.",
          "en": "Liu Jing: Three."
        },
        {
          "zh": "服务员：请坐。这是菜单。你们要什么？",
          "py": "Fúwùyuán: Qǐng zuò. Zhè shì càidān. Nǐmen yào shénme?",
          "en": "Waiter: Please sit down. Here's the menu. What would you like?"
        },
        {
          "zh": "刘京：大卫，你想吃什么？",
          "py": "Liú Jīng: Dàwèi, nǐ xiǎng chī shénme?",
          "en": "Liu Jing: David, what would you like to eat?"
        },
        {
          "zh": "大卫：我不太会点菜，你帮我点吧。",
          "py": "Dàwèi: Wǒ bú tài huì diǎn cài, nǐ bāng wǒ diǎn ba.",
          "en": "David: I can't really order, please help me."
        },
        {
          "zh": "刘京：来一个鱼香肉丝、一个麻婆豆腐、一个宫保鸡丁。",
          "py": "Liú Jīng: Lái yī gè yúxiāng ròusī, yī gè mápó dòufu, yī gè gōngbǎo jīdīng.",
          "en": "Liu Jing: Fish-flavored pork, mapo tofu, and kung pao chicken."
        },
        {
          "zh": "服务员：好的。你们想喝点儿什么？",
          "py": "Fúwùyuán: Hǎo de. Nǐmen xiǎng hē diǎnr shénme?",
          "en": "Waiter: OK. What would you like to drink?"
        },
        {
          "zh": "刘京：来两瓶啤酒，一杯橙汁。",
          "py": "Liú Jīng: Lái liǎng píng píjiǔ, yī bēi chéngzhī.",
          "en": "Liu Jing: Two bottles of beer, and one orange juice."
        },
        {
          "zh": "服务员：好的，请稍等。",
          "py": "Fúwùyuán: Hǎo de, qǐng shāo děng.",
          "en": "Waiter: OK, one moment please."
        }
      ]
    },
    {
      "topic": "会话2 · Dialogue 2 (During the Meal)",
      "items": [
        {
          "zh": "刘京：大卫，尝尝这个菜。味道怎么样？",
          "py": "Liú Jīng: Dàwèi, chángchang zhège cài. Wèidao zěnmeyàng?",
          "en": "Liu Jing: David, try this dish. How does it taste?"
        },
        {
          "zh": "大卫：好吃极了！",
          "py": "Dàwèi: Hǎo chī jí le!",
          "en": "David: Extremely delicious!"
        },
        {
          "zh": "玛丽：这个麻婆豆腐太辣了。",
          "py": "Mǎlì: Zhège mápó dòufu tài là le.",
          "en": "Mary: This mapo tofu is too spicy."
        },
        {
          "zh": "刘京：那你尝尝这个，不辣。",
          "py": "Liú Jīng: Nà nǐ chángchang zhège, bú là.",
          "en": "Liu Jing: Then try this one, it's not spicy."
        },
        {
          "zh": "玛丽：嗯，这个不错。",
          "py": "Mǎlì: Ǹg, zhège búcuò.",
          "en": "Mary: Mm, this one is good."
        },
        {
          "zh": "刘京：菜够了吗？再来一个汤吧。",
          "py": "Liú Jīng: Cài gòu le ma? Zài lái yī gè tāng ba.",
          "en": "Liu Jing: Enough dishes? Let's get a soup too."
        },
        {
          "zh": "大卫：够了够了，太多了。",
          "py": "Dàwèi: Gòu le gòu le, tài duō le.",
          "en": "David: Enough, that's too much."
        },
        {
          "zh": "刘京：服务员，买单！",
          "py": "Liú Jīng: Fúwùyuán, mǎi dān!",
          "en": "Liu Jing: Waiter, check please!"
        },
        {
          "zh": "服务员：一共一百五十八块。",
          "py": "Fúwùyuán: Yīgòng yībǎi wǔshíbā kuài.",
          "en": "Waiter: 158 yuan in total."
        }
      ]
    },
