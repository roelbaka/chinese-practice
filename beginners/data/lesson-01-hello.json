      "topic": "语法 · Grammar",
      "items": [
        { "zh": "我很好。", "py": "Wǒ hěn hǎo.", "en": "I am fine. (很 + adjective = 'am/is' + adj)" },
        { "zh": "他也很好。", "py": "Tā yě hěn hǎo.", "en": "He is fine too. (也 = also, before the verb)" },
        { "zh": "他们都很好。", "py": "Tāmen dōu hěn hǎo.", "en": "They are all fine. (都 = all, before the verb)" },
        { "zh": "你好吗？", "py": "Nǐ hǎo ma?", "en": "Are you well? (吗 turns a statement into a question)" },
        { "zh": "你呢？", "py": "Nǐ ne?", "en": "And you? (呢 asks 'what about...?')" },
        { "zh": "我不好。", "py": "Wǒ bù hǎo.", "en": "I'm not good. (不 negates adjectives/verbs)" }
      ]
    },
