      "topic": "注释 · Notes (textbook)",
      "items": [
        { "zh": "你好", "py": "Nǐ hǎo", "en": "Hello! / Hi! — An everyday greeting used at any time, on any occasion, by anyone. The reply is also '你好'." },
        { "zh": "你好吗？", "py": "Nǐ hǎo ma?", "en": "How are you? — A common greeting between acquaintances. The usual reply is '我很好' (I'm fine)." }
