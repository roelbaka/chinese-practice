      "topic": "句子 · Key Sentences",
      "items": [
        {
          "zh": "你的生日是几月几号？",
          "py": "Nǐ de shēngrì shì jǐ yuè jǐ hào?",
          "en": "When is your birthday? (lit. Your birthday is which month which date?)"
        },
        {
          "zh": "我的生日是五月二十号。",
          "py": "Wǒ de shēngrì shì wǔ yuè èrshí hào.",
          "en": "My birthday is May 20th."
        },
        {
          "zh": "今天几号？",
          "py": "Jīntiān jǐ hào?",
          "en": "What date is today?"
        },
        {
          "zh": "今天星期几？",
          "py": "Jīntiān xīngqī jǐ?",
          "en": "What day of the week is today?"
        },
        {
          "zh": "今年是二〇二六年。",
          "py": "Jīnnián shì èr líng èr liù nián.",
          "en": "This year is 2026."
        }
      ]
    },
