      "items": [
        {
          "zh": "玛丽：你的生日是几月几号？",
          "py": "Mǎlì: Nǐ de shēngrì shì jǐ yuè jǐ hào?",
          "en": "Mary: When is your birthday?"
        },
        {
          "zh": "大卫：我的生日是八月十五号。你呢？",
          "py": "Dàwèi: Wǒ de shēngrì shì bā yuè shíwǔ hào. Nǐ ne?",
          "en": "David: My birthday is August 15th. How about you?"
        },
        {
          "zh": "玛丽：我的生日是三月八号。",
          "py": "Mǎlì: Wǒ de shēngrì shì sān yuè bā hào.",
          "en": "Mary: My birthday is March 8th."
        },
        {
          "zh": "大卫：你今年多大？",
          "py": "Dàwèi: Nǐ jīnnián duō dà?",
          "en": "David: How old are you this year?"
        },
        {
          "zh": "玛丽：我二十岁。",
          "py": "Mǎlì: Wǒ èrshí suì.",
          "en": "Mary: I'm twenty (years old)."
        },
        {
          "zh": "大卫：祝你生日快乐！",
          "py": "Dàwèi: Zhù nǐ shēngrì kuàilè!",
          "en": "David: Happy birthday to you!"
        },
        {
          "zh": "玛丽：谢谢！",
          "py": "Mǎlì: Xièxie!",
          "en": "Mary: Thank you!"
        }
      ]
