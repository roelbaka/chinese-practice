        {
          "zh": "王兰：今天几号？",
          "py": "Wáng Lán: Jīntiān jǐ hào?",
          "en": "Wang Lan: What's today's date?"
        },
        {
          "zh": "和子：今天是四月四号，星期五。",
          "py": "Hézǐ: Jīntiān shì sì yuè sì hào, xīngqī wǔ.",
          "en": "Kazuko: Today is April 4th, Friday."
        },
        {
          "zh": "王兰：明天是星期六，我们去商店买东西吧。",
          "py": "Wáng Lán: Míngtiān shì xīngqī liù, wǒmen qù shāngdiàn mǎi dōngxi ba.",
          "en": "Wang Lan: Tomorrow is Saturday — let's go to the shop to buy something."
        },
        {
          "zh": "和子：好。去年十二月我很忙，今年好一点。",
