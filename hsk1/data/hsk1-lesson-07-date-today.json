        {
          "zh": "A：请问，今天几号？",
          "py": "A: Qǐngwèn, jīntiān jǐ hào?",
          "en": "A: Excuse me, what's the date today?"
        },
        {
          "zh": "B：今天9月1号。",
          "py": "B: Jīntiān jiǔ yuè yī hào.",
          "en": "B: It's September 1st."
        },
        {
          "zh": "A：今天星期几？",
          "py": "A: Jīntiān xīngqī jǐ?",
          "en": "A: What day is it today?"
        },
        {
          "zh": "B：星期三。",
          "py": "B: Xīngqī sān.",
          "en": "B: It's Wednesday."
        }
      ]
